+    [[nodiscard]] std::uint64_t perft2_scalar(const Board &b, Bitboard moves) noexcept {
+      std::uint64_t total = 0;
+      while (moves) {
+        const Board child = b.play(pop_lsb(moves));
+        const Bitboard replies = child.moves();
+        total += replies ? static_cast<std::uint64_t>(popcount(replies)) : stuck_leaf_count<R>(child);
+      }
+      return total;
+    }
